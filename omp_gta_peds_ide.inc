static stock bool:PedsIde_ParseLine(const line[]) {
    new field[GTA_PEDS_IDE_MAX_FIELD_LENGTH];

    new modelId;

    new modelName[GTA_PEDS_IDE_NAME_LENGTH];
    new txdName[GTA_PEDS_IDE_NAME_LENGTH];

    new typeName[GTA_PEDS_IDE_TYPE_LENGTH];
    new statName[GTA_PEDS_IDE_STAT_LENGTH];
    new animGroup[GTA_PEDS_IDE_ANIM_GROUP_LENGTH];

    new driveMask;
    new flags;

    new animFile[GTA_PEDS_IDE_ANIM_FILE_LENGTH];

    new E_GTA_PEDS_IDE_RADIO:radio1;
    new E_GTA_PEDS_IDE_RADIO:radio2;
    new radioValue;

    new pedTypeName[GTA_PEDS_IDE_SPEECH_TYPE_LENGTH];

    new voice1[GTA_PEDS_IDE_VOICE_LENGTH];
    new voice2[GTA_PEDS_IDE_VOICE_LENGTH];

    if(!PedsIde_GetCommaField(line, 0, field, sizeof(field)))
        return false;

    if(!PedsIde_ParseInt(field, modelId))
        return false;

    if(!PedsIde_GetCommaField(line, 1, modelName, sizeof(modelName)))
        return false;

    if(!PedsIde_GetCommaField(line, 2, txdName, sizeof(txdName)))
        return false;

    if(!PedsIde_GetCommaField(line, 3, typeName, sizeof(typeName)))
        return false;

    new E_GTA_PEDS_IDE_TYPE:pedIdeType = PedsIde_GetType(typeName);

    if(pedIdeType == GTA_PEDS_IDE_TYPE_UNKNOWN)
        return false;

    if(!PedsIde_GetCommaField(line, 4, statName, sizeof(statName)))
        return false;

    new E_GTA_PEDS_IDE_STAT:pedIdeStat = PedsIde_GetStat(statName);

    if(pedIdeStat == GTA_PEDS_IDE_STAT_UNKNOWN)
        return false;

    if(!PedsIde_GetCommaField(line, 5, animGroup, sizeof(animGroup)))
        return false;

    if(!PedsIde_GetCommaField(line, 6, field, sizeof(field)))
        return false;

    if(!PedsIde_ParseHex(field, driveMask))
        return false;

    if(!PedsIde_GetCommaField(line, 7, field, sizeof(field)))
        return false;

    if(!PedsIde_ParseHex(field, flags))
        return false;

    if(!PedsIde_GetCommaField(line, 8, animFile, sizeof(animFile)))
        return false;

    if(!PedsIde_GetCommaField(line, 9, field, sizeof(field)))
        return false;

    if(!PedsIde_ParseInt(field, radioValue))
        return false;

    if(radioValue < _:GTA_PEDS_IDE_RADIO_CLASSIC_HIP_HOP || radioValue > _:GTA_PEDS_IDE_RADIO_USER_TRACKS)
        return false;

    radio1 = E_GTA_PEDS_IDE_RADIO:radioValue;

    /*
    * Still 20 years later and still fixing Rockstar's typos, fix BMYMOUN
    */
    if(!PedsIde_GetCommaField(line, 10, field, sizeof(field)))
        return false;

    if(modelId == 51 && !strcmp(field, "0 PED_TYPE_GEN", true)) {
        radio2 = GTA_PEDS_IDE_RADIO_CLASSIC_HIP_HOP;

        format(pedTypeName, sizeof(pedTypeName), "PED_TYPE_GEN");

        if(!PedsIde_GetCommaField(line, 11, voice1, sizeof(voice1)))
            return false;

        if(!PedsIde_GetCommaField(line, 12, voice2, sizeof(voice2)))
            return false;

        if(PedsIde_GetCommaField(line, 13, field, sizeof(field)))
            return false;
    } else {
        if(!PedsIde_ParseInt(field, radioValue))
            return false;

        if(radioValue < _:GTA_PEDS_IDE_RADIO_CLASSIC_HIP_HOP || radioValue > _:GTA_PEDS_IDE_RADIO_USER_TRACKS)
            return false;

        radio2 = E_GTA_PEDS_IDE_RADIO:radioValue;

        if(!PedsIde_GetCommaField(line, 11, pedTypeName, sizeof(pedTypeName)))
            return false;

        if(!PedsIde_GetCommaField(line, 12, voice1, sizeof(voice1)))
            return false;

        if(!PedsIde_GetCommaField(line, 13, voice2, sizeof(voice2)))
            return false;

        if(PedsIde_GetCommaField(line, 14, field, sizeof(field)))
            return false;
    }

    new E_GTA_PEDS_IDE_SPEECH_TYPE:speechType =
        PedsIde_GetSpeechType(pedTypeName);

    if(speechType == GTA_PEDS_IDE_SPEECH_TYPE_UNKNOWN)
        return false;

    if(gPedsIdeCount >= GTA_PEDS_IDE_MAX_PEDS) {
        printf("[omp-gta-peds-ide] ERROR: Maximum ped count reached (%d).", GTA_PEDS_IDE_MAX_PEDS);

        return false;
    }

    for(new i = 0; i < gPedsIdeCount; i++) {
        if(gPedsIde[i][GTA_PEDS_IDE_MODEL_ID] == modelId) {
            printf("[omp-gta-peds-ide] ERROR: Duplicate model id: %d", modelId);
            return false;
        }

        if(!strcmp(gPedsIde[i][GTA_PEDS_IDE_NAME], modelName, true)) {
            printf("[omp-gta-peds-ide] ERROR: Duplicate model name: '%s'", modelName);
            return false;
        }
    }

    gPedsIde[gPedsIdeCount][GTA_PEDS_IDE_MODEL_ID] = modelId;

    format(gPedsIde[gPedsIdeCount][GTA_PEDS_IDE_NAME], GTA_PEDS_IDE_NAME_LENGTH, "%s", modelName);
    format(gPedsIde[gPedsIdeCount][GTA_PEDS_IDE_TXD_NAME], GTA_PEDS_IDE_NAME_LENGTH, "%s", txdName);

    gPedsIde[gPedsIdeCount][GTA_PEDS_IDE_TYPE] = pedIdeType;
    gPedsIde[gPedsIdeCount][GTA_PEDS_IDE_STAT] = pedIdeStat;

    format(gPedsIde[gPedsIdeCount][GTA_PEDS_IDE_ANIM_GROUP], GTA_PEDS_IDE_ANIM_GROUP_LENGTH, "%s", animGroup);

    gPedsIde[gPedsIdeCount][GTA_PEDS_IDE_DRIVE_MASK] = driveMask;
    gPedsIde[gPedsIdeCount][GTA_PEDS_IDE_FLAGS] = flags;

    format(gPedsIde[gPedsIdeCount][GTA_PEDS_IDE_ANIM_FILE], GTA_PEDS_IDE_ANIM_FILE_LENGTH, "%s", animFile);

    gPedsIde[gPedsIdeCount][GTA_PEDS_IDE_RADIO_1] = radio1;
    gPedsIde[gPedsIdeCount][GTA_PEDS_IDE_RADIO_2] = radio2;
    gPedsIde[gPedsIdeCount][GTA_PEDS_IDE_SPEECH_TYPE] = speechType;

    format(gPedsIde[gPedsIdeCount][GTA_PEDS_IDE_VOICE_MIN], GTA_PEDS_IDE_VOICE_LENGTH, "%s", voice1);
    format(gPedsIde[gPedsIdeCount][GTA_PEDS_IDE_VOICE_MAX], GTA_PEDS_IDE_VOICE_LENGTH, "%s", voice2);

    gPedsIdeCount++;

    return true;
}

