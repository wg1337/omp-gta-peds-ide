stock bool:LoadPedsIde(const filename[] = GTA_PEDS_IDE_FILE) {
    gPedsIdeCount = 0;
    gPedsIdeLoaded = false;

    new File:file = fopen(filename, io_read);

    if(!file) {
        printf("[omp-gta-peds-ide] ERROR: Could not open '%s'.", filename);
        return false;
    }

    new line[GTA_PEDS_IDE_MAX_LINE_LENGTH];
    new bool:inPedsSection = false;
    new bool:foundPedsSection = false;
    new bool:foundPedsEnd = false;
    new parseErrors = 0;
    new length;

    while((length = fread(file, line)) > 0) {
        while(length > 0 && (line[length - 1] == '\r' || line[length - 1] == '\n'))
            line[--length] = '\0';

        if(PedsIde_IsCommentOrEmpty(line))
            continue;

        if(!strcmp(line, "peds", true)) {
            inPedsSection = true;
            foundPedsSection = true;
            continue;
        }

        if(!strcmp(line, "end", true)) {
            if(inPedsSection) {
                foundPedsEnd = true;
                break;
            }

            continue;
        }

        if(!inPedsSection)
            continue;

        if(!PedsIde_ParseLine(line)) {
            printf("[omp-gta-peds-ide] ERROR: Failed to parse line: %s", line);
            parseErrors++;
        }
    }

    fclose(file);

    if(!foundPedsSection) {
        printf("[omp-gta-peds-ide] ERROR: Could not find peds section in '%s'.", filename);
        gPedsIdeCount = 0;
        return false;
    }

    if(!foundPedsEnd) {
        printf("[omp-gta-peds-ide] ERROR: Unterminated peds section in '%s'.", filename);
        gPedsIdeCount = 0;
        return false;
    }

    if(gPedsIdeCount <= 0) {
        printf("[omp-gta-peds-ide] ERROR: No ped entries loaded from '%s'.", filename);
        gPedsIdeCount = 0;
        gPedsIdeLoaded = false;
        return false;
    }

    if(parseErrors > 0) {
        printf("[omp-gta-peds-ide] ERROR: Failed to parse %d ped entries from '%s'.", parseErrors, filename);

        gPedsIdeCount = 0;
        return false;
    }

    gPedsIdeLoaded = true;

    printf("[omp-gta-peds-ide] Loaded %d ped entries from '%s'.", gPedsIdeCount, filename);
    return true;
}

