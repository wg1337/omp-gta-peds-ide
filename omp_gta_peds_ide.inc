static stock PedsIde_GetSpecificContext(E_GTA_PEDS_IDE_SPEECH_TYPE:type, E_GTA_PEDS_IDE_SPEECH_CONTEXT:globalContext) {
    if(_:globalContext < 0 || _:globalContext >= GTA_PEDS_IDE_SPEECH_GLOBAL_CONTEXT_COUNT)
        return -1;

    if(_:type < _:GTA_PEDS_IDE_SPEECH_TYPE_GEN || _:type > _:GTA_PEDS_IDE_SPEECH_TYPE_GFD)
        return -1;

    return gPedSpeechContextMap[(_:globalContext * 5) + _:type];
}

static stock bool:PedsIde_UnpackRange(packed, &firstSample, &lastSample) {
    firstSample = (packed >>> 16) & 0xFFFF;
    lastSample = packed & 0xFFFF;

    if(firstSample == 0xFFFF || lastSample == 0xFFFF || lastSample < firstSample) {
        firstSample = -1;
        lastSample = -1;

        return false;
    }

    return true;
}

static stock bool:PedsIde_GetSampleRange(E_GTA_PEDS_IDE_SPEECH_TYPE:type, localContext, voiceId, &firstSample, &lastSample) {
    firstSample = -1;
    lastSample = -1;

    new packed;

    switch(type) {
        case GTA_PEDS_IDE_SPEECH_TYPE_GEN: {
            if(localContext < 0 || localContext >= GTA_PEDS_IDE_SPEECH_GEN_CONTEXT_COUNT || voiceId < 0 || voiceId >= GTA_PEDS_IDE_SPEECH_GEN_VOICE_COUNT) {
                return false;
            }

            packed = gPedSpeechGenRanges[localContext * GTA_PEDS_IDE_SPEECH_GEN_VOICE_COUNT + voiceId];
        }

        case GTA_PEDS_IDE_SPEECH_TYPE_EMG: {
            if(localContext < 0 || localContext >= GTA_PEDS_IDE_SPEECH_EMG_CONTEXT_COUNT || voiceId < 0 || voiceId >= GTA_PEDS_IDE_SPEECH_EMG_VOICE_COUNT) {
                return false;
            }

            packed = gPedSpeechEmgRanges[localContext * GTA_PEDS_IDE_SPEECH_EMG_VOICE_COUNT + voiceId];
        }

        case GTA_PEDS_IDE_SPEECH_TYPE_PLAYER: {
            if(localContext < 0 || localContext >= GTA_PEDS_IDE_SPEECH_PLAYER_CONTEXT_COUNT || voiceId < 0 || voiceId >= GTA_PEDS_IDE_SPEECH_PLAYER_VOICE_COUNT) {
                return false;
            }

            packed = gPedSpeechPlayerRanges[localContext * GTA_PEDS_IDE_SPEECH_PLAYER_VOICE_COUNT + voiceId];
        }

        case GTA_PEDS_IDE_SPEECH_TYPE_GANG: {
            if(localContext < 0 || localContext >= GTA_PEDS_IDE_SPEECH_GANG_CONTEXT_COUNT || voiceId < 0 || voiceId >= GTA_PEDS_IDE_SPEECH_GANG_VOICE_COUNT) {
                return false;
            }

            packed = gPedSpeechGangRanges[localContext * GTA_PEDS_IDE_SPEECH_GANG_VOICE_COUNT + voiceId];
        }

        case GTA_PEDS_IDE_SPEECH_TYPE_GFD: {
            if(localContext < 0 || localContext >= GTA_PEDS_IDE_SPEECH_GFD_CONTEXT_COUNT || voiceId < 0 || voiceId >= GTA_PEDS_IDE_SPEECH_GFD_VOICE_COUNT) {
                return false;
            }

            packed = gPedSpeechGfdRanges[localContext * GTA_PEDS_IDE_SPEECH_GFD_VOICE_COUNT + voiceId];
        }

        default: {
            return false;
        }
    }

    return PedsIde_UnpackRange(packed, firstSample, lastSample);
}

static stock PedsIde_GetBankId(E_GTA_PEDS_IDE_SPEECH_TYPE:type, voiceId) {
    switch(type) {
        case GTA_PEDS_IDE_SPEECH_TYPE_GEN: {
            if(voiceId >= 0 && voiceId < GTA_PEDS_IDE_SPEECH_GEN_VOICE_COUNT) {
                return GTA_PEDS_IDE_SPEECH_GEN_FIRST_BANK + voiceId;
            }
        }

        case GTA_PEDS_IDE_SPEECH_TYPE_EMG: {
            if(voiceId >= 0 && voiceId < GTA_PEDS_IDE_SPEECH_EMG_VOICE_COUNT) {
                return GTA_PEDS_IDE_SPEECH_EMG_FIRST_BANK + voiceId;
            }
        }

        case GTA_PEDS_IDE_SPEECH_TYPE_PLAYER: {
            if(voiceId >= 0 && voiceId < GTA_PEDS_IDE_SPEECH_PLAYER_VOICE_COUNT) {
                return GTA_PEDS_IDE_SPEECH_PLAYER_FIRST_BANK + voiceId;
            }
        }

        case GTA_PEDS_IDE_SPEECH_TYPE_GANG: {
            if(voiceId >= 0 && voiceId < GTA_PEDS_IDE_SPEECH_GANG_VOICE_COUNT) {
                return GTA_PEDS_IDE_SPEECH_GANG_FIRST_BANK + voiceId;
            }
        }

        case GTA_PEDS_IDE_SPEECH_TYPE_GFD: {
            if(voiceId >= 0 && voiceId < GTA_PEDS_IDE_SPEECH_GFD_VOICE_COUNT) {
                return GTA_PEDS_IDE_SPEECH_GFD_FIRST_BANK + voiceId;
            }
        }

        case GTA_PEDS_IDE_SPEECH_TYPE_UNKNOWN, GTA_PEDS_IDE_SPEECH_TYPE_SPC: {
            return -1;
        }
    }

    return -1;
}

