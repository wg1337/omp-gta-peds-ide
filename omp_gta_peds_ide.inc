    while(start < end && (source[start] == ' ' || source[start] == '\t')) {
        start++;
    }

    while(end > start && (source[end - 1] == ' ' || source[end - 1] == '\t' || source[end - 1] == '\r' || source[end - 1] == '\n')) {
        end--;
    }

    new length = end - start;

    if(length <= 0)
        return false;

    if(length >= destinationSize)
        return false;

    for(new i = 0; i < length; i++) {
        destination[i] = source[start + i];
    }

    destination[length] = '\0';
    return true;
}

static stock bool:PedsIde_GetCommaField(const line[], fieldIndex, output[], outputSize) {
    new currentField = 0;
    new start = 0;
    new length = strlen(line);

    for(new i = 0; i <= length; i++) {
        if(line[i] == ',' || line[i] == '\0') {
            if(currentField == fieldIndex) {
                return PedsIde_CopyTrimmedRange(line, start, i, output, outputSize);
            }

            currentField++;
            start = i + 1;
        }
    }

    return false;
}

static stock bool:PedsIde_IsCommentOrEmpty(const line[]) {
    new length = strlen(line);

    for(new i = 0; i < length; i++) {
        if(line[i] != ' ' && line[i] != '\t' && line[i] != '\r' && line[i] != '\n') {
            return line[i] == '#';
        }
    }

    return true;
}

static stock PedsIde_HexValue(character) {
    if(character >= '0' && character <= '9')
        return character - '0';

    if(character >= 'a' && character <= 'f')
        return character - 'a' + 10;

    if(character >= 'A' && character <= 'F')
        return character - 'A' + 10;

    return -1;
}

static stock bool:PedsIde_ParseHex(const value[], &result) {
    result = 0;

    new i = 0;

    if(value[0] == '0' && (value[1] == 'x' || value[1] == 'X'))
        i = 2;

    if(value[i] == '\0')
        return false;

    new digits = 0;

    for(; value[i] != '\0'; i++) {
        new digit = PedsIde_HexValue(value[i]);

        if(digit == -1)
            return false;

        if(digits >= 8)
            return false;

        result = (result << 4) | digit;
        digits++;
    }

    return digits > 0;
}

static stock bool:PedsIde_ParseInt(const value[], &result) {
    if(value[0] == '\0')
        return false;

    new i = 0;
    new sign = 1;

    if(value[i] == '-') {
        sign = -1;
        i++;

        if(value[i] == '\0')
            return false;
    } else if(value[i] == '+') {
        i++;

        if(value[i] == '\0')
            return false;
    }

    new number = 0;

    for(; value[i] != '\0'; i++) {
        if(value[i] < '0' || value[i] > '9')
            return false;

        new digit = value[i] - '0';

        if(number > (2147483647 - digit) / 10)
            return false;

        number = number * 10 + digit;
    }

    result = number * sign;
    return true;
}

