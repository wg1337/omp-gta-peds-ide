/*
* Tests the loaded peds.ide data.
*
* TestPedIde();
* TestPedIde(GTA_PEDS_IDE_TYPE_CIVMALE);
* TestPedIde(E_GTA_PEDS_IDE_TYPE:-1, GTA_PEDS_IDE_STAT_GANG1);
* TestPedIde(E_GTA_PEDS_IDE_TYPE:-1, E_GTA_PEDS_IDE_STAT:-1, GTA_PEDS_IDE_SPEECH_TYPE_GANG);
*/
stock bool:TestPedIde(E_GTA_PEDS_IDE_TYPE:filterType = E_GTA_PEDS_IDE_TYPE:-1, E_GTA_PEDS_IDE_STAT:filterStat = E_GTA_PEDS_IDE_STAT:-1, E_GTA_PEDS_IDE_SPEECH_TYPE:filterSpeechType = E_GTA_PEDS_IDE_SPEECH_TYPE:-1) {
    if(!IsPedIdeLoaded()) {
        print("[omp-gta-peds-ide] TEST FAILED: peds.ide is not loaded.");
        return false;
    }

    new checked = 0;
    new invalid = 0;

    printf("[omp-gta-peds-ide] Testing peds.ide: type=%d stat=%d speechType=%d", _:filterType, _:filterStat, _:filterSpeechType);

    for(new i = 0; i < gPedsIdeCount; i++) {
        new modelId = gPedsIde[i][GTA_PEDS_IDE_MODEL_ID];
        new E_GTA_PEDS_IDE_TYPE:type = E_GTA_PEDS_IDE_TYPE:gPedsIde[i][GTA_PEDS_IDE_TYPE];
        new E_GTA_PEDS_IDE_STAT:stat = E_GTA_PEDS_IDE_STAT:gPedsIde[i][GTA_PEDS_IDE_STAT];
        new E_GTA_PEDS_IDE_SPEECH_TYPE:speechType = E_GTA_PEDS_IDE_SPEECH_TYPE:gPedsIde[i][GTA_PEDS_IDE_SPEECH_TYPE];

        if(filterType != E_GTA_PEDS_IDE_TYPE:-1 && type != filterType)
            continue;

        if(filterStat != E_GTA_PEDS_IDE_STAT:-1 && stat != filterStat)
            continue;

        if(filterSpeechType != E_GTA_PEDS_IDE_SPEECH_TYPE:-1 && speechType != filterSpeechType)
            continue;

        checked++;

        new name[GTA_PEDS_IDE_NAME_LENGTH];
        new txd[GTA_PEDS_IDE_NAME_LENGTH];
        new animGroup[GTA_PEDS_IDE_ANIM_GROUP_LENGTH];
        new animFile[GTA_PEDS_IDE_ANIM_FILE_LENGTH];
        new voice1[GTA_PEDS_IDE_VOICE_LENGTH];
        new voice2[GTA_PEDS_IDE_VOICE_LENGTH];

        new E_GTA_PEDS_IDE_RADIO:radio1;
        new E_GTA_PEDS_IDE_RADIO:radio2;

        new bool:valid = true;

        if(!GetPedsIdeNameByModel(modelId, name, sizeof(name)))
            valid = false;

        if(!GetPedsIdeTxdNameByModel(modelId, txd, sizeof(txd)))
            valid = false;

        if(GetPedsIdeTypeByModel(modelId) != type)
            valid = false;

        if(GetPedsIdeStatByModel(modelId) != stat)
            valid = false;

        if(!GetPedsIdeAnimGroupByModel(modelId, animGroup, sizeof(animGroup)))
            valid = false;

        if(!GetPedsIdeAnimFileByModel(modelId, animFile, sizeof(animFile)))
            valid = false;

        if(GetPedsIdeSpeechTypeByModel(modelId) != speechType)
            valid = false;

        if(!GetPedsIdeRadioByModel(modelId, radio1, radio2))
            valid = false;

        if(!GetPedsIdeVoiceRangeByModel(modelId, voice1, sizeof(voice1), voice2, sizeof(voice2))) {
            valid = false;
        }

        if(GetPedsIdeModelIdByName(name) != modelId)
            valid = false;

        if(radio1 < GTA_PEDS_IDE_RADIO_CLASSIC_HIP_HOP || radio1 > GTA_PEDS_IDE_RADIO_USER_TRACKS) {
            valid = false;
        }

        if(radio2 < GTA_PEDS_IDE_RADIO_CLASSIC_HIP_HOP || radio2 > GTA_PEDS_IDE_RADIO_USER_TRACKS) {
            valid = false;
        }

        printf("[%03d] model=%d name='%s' txd='%s' type=%d stat=%d pedType=%d radio=%d/%d %s", i, modelId, name, txd, _:type, _:stat, _:speechType, _:radio1, _:radio2, valid ? "PASS" : "FAIL");
        printf("      animGroup='%s' animFile='%s' voices='%s'/'%s'", animGroup, animFile, voice1, voice2);

        if(!valid)
            invalid++;
    }

    print("------------------------------------------------------------");
    printf("Peds checked:               %d / %d", checked, gPedsIdeCount);
    printf("Invalid peds:               %d", invalid);

    if(checked == 0) {
        print("FAIL: No peds matched the selected filters.");
        return false;
    }

    if(invalid != 0) {
        printf("FAIL: %d of %d selected peds failed validation.", invalid, checked);
        return false;
    }

    printf("PASS: All %d selected peds passed validation.", checked);

    return true;
}

/*
* Returns the speech type and possible voice IDs for a ped model.
*/
stock bool:GetPedsIdeSpeechVoicesByModel(modelId, &E_GTA_PEDS_IDE_SPEECH_TYPE:type, &voiceMin, &voiceMax) {
    type = GTA_PEDS_IDE_SPEECH_TYPE_UNKNOWN;
    voiceMin = -1;
    voiceMax = -1;

    new E_GTA_PEDS_IDE_SPEECH_TYPE:pedSpeechType = GetPedsIdeSpeechTypeByModel(modelId);

    if(pedSpeechType == GTA_PEDS_IDE_SPEECH_TYPE_UNKNOWN || pedSpeechType == GTA_PEDS_IDE_SPEECH_TYPE_SPC) {
        return false;
    }

    type = E_GTA_PEDS_IDE_SPEECH_TYPE:pedSpeechType;

    new voice1[GTA_PEDS_IDE_VOICE_LENGTH];
    new voice2[GTA_PEDS_IDE_VOICE_LENGTH];

    if(!GetPedsIdeVoiceRangeByModel(modelId, voice1, sizeof(voice1), voice2, sizeof(voice2))) {
        return false;
    }

    voiceMin = PedsIde_GetVoiceId(type, voice1);
    voiceMax = PedsIde_GetVoiceId(type, voice2);

    if(voiceMin < 0 || voiceMax < 0)
        return false;

    if(voiceMax < voiceMin) {
        new temp = voiceMin;
        voiceMin = voiceMax;
        voiceMax = temp;
    }

    return true;
}

/*
* Returns the number of different voice lines available to a ped model for the specified global speech context.
* For example, how many different lines the model can use for GTA_PEDS_IDE_SPEECH_CONTEXT_CHAT.
*/
stock GetPedsIdeSpeechSampleCount(modelId, E_GTA_PEDS_IDE_SPEECH_CONTEXT:globalContext) {
    new E_GTA_PEDS_IDE_SPEECH_TYPE:type;
    new voiceMin;
    new voiceMax;

    if(!GetPedsIdeSpeechVoicesByModel(modelId, type, voiceMin, voiceMax)) {
        return 0;
    }

    new specificContext = PedsIde_GetSpecificContext(type, globalContext);

    if(specificContext < 0)
        return 0;

    new count = 0;

    for(new voice = voiceMin; voice <= voiceMax; voice++) {
        new firstSample;
        new lastSample;

        if(!PedsIde_GetSampleRange(type, specificContext, voice, firstSample, lastSample)) {
            continue;
        }

        count += lastSample - firstSample + 1;
    }

    return count;
}

/*
* Gets the GTA audio bank ID and sample ID of a speech line by index.
* Use GetPedsIdeSpeechSampleCount() to get the number of available samples.
*/
stock bool:GetPedsIdeSpeechSampleByIndex(modelId, E_GTA_PEDS_IDE_SPEECH_CONTEXT:globalContext, index, &bankId, &sampleId) {
    bankId = -1;
    sampleId = -1;

    if(index < 0)
        return false;

    new E_GTA_PEDS_IDE_SPEECH_TYPE:type;
    new voiceMin;
    new voiceMax;

    if(!GetPedsIdeSpeechVoicesByModel(modelId, type, voiceMin, voiceMax)) {
        return false;
    }

    new specificContext = PedsIde_GetSpecificContext(
        type,
        globalContext
    );

    if(specificContext < 0)
        return false;

    new currentIndex = 0;

    for(new voice = voiceMin; voice <= voiceMax; voice++) {
        new firstSample;
        new lastSample;

        if(!PedsIde_GetSampleRange(type, specificContext, voice, firstSample, lastSample)) {
            continue;
        }

        new sampleCount = lastSample - firstSample + 1;

        if(index < currentIndex + sampleCount) {
            bankId = PedsIde_GetBankId(type, voice);

            if(bankId < 0) {
                bankId = -1;
                return false;
            }

            sampleId = firstSample + (index - currentIndex);

            return true;
        }

        currentIndex += sampleCount;
    }

    return false;
}

/*
* Converts a GTA speech (bank, sample) pair to a PlayerPlaySound sound ID.
*
* The formula used to encode bankId/sampleId is:
*     soundId = 2000 + ((bankId - 147) * 200) + sampleId;
* IMPORTANT: This function only works sometimes on the SA-MP/open.mp client.
* Some sound IDs above 45400 can be silent because samp.dll does not properly set their volume.
* Some IDs work while others do not. Be warned.
*
*/
stock GetPedsIdeSpeechPlayerPlaySoundId(bankId, sampleId) {
    if(bankId < GTA_PEDS_IDE_SPEECH_FIRST_BANK || bankId > GTA_PEDS_IDE_SPEECH_LAST_BANK || sampleId < 0 || sampleId >= GTA_PEDS_IDE_SPEECH_BANK_STRIDE) {
        return -1;
    }

    return GTA_PEDS_IDE_SPEECH_PLAYERPLAYSOUND_BASE + ((bankId - GTA_PEDS_IDE_SPEECH_SCRIPT_FIRST_BANK) * GTA_PEDS_IDE_SPEECH_BANK_STRIDE) + sampleId;
}

/*
* Converts a GTA speech bank/sample pair to its speech archive.
*/
stock bool:GetPedsIdeSpeechArchiveSample(bankId, sampleId, archive[], archiveSize, &archiveBankId, &archiveSampleId) {
    if(archiveSize <= 0)
        return false;

    archive[0] = '\0';
    archiveBankId = -1;
    archiveSampleId = -1;

    if(sampleId < 0)
        return false;

    if(bankId >= GTA_PEDS_IDE_SPEECH_EMG_FIRST_BANK && bankId <= GTA_PEDS_IDE_SPEECH_EMG_LAST_BANK) {
        format(archive, archiveSize, "SPC_EA");
        archiveBankId = bankId - GTA_PEDS_IDE_SPEECH_EMG_FIRST_BANK;
    } else if(bankId >= GTA_PEDS_IDE_SPEECH_GFD_FIRST_BANK && bankId <= GTA_PEDS_IDE_SPEECH_GFD_LAST_BANK) {
        format(archive, archiveSize, "SPC_FA");
        archiveBankId = bankId - GTA_PEDS_IDE_SPEECH_GFD_FIRST_BANK;
    } else if(bankId >= GTA_PEDS_IDE_SPEECH_GEN_FIRST_BANK && bankId <= GTA_PEDS_IDE_SPEECH_GEN_LAST_BANK) {
        format(archive, archiveSize, "SPC_GA");
        archiveBankId = bankId - GTA_PEDS_IDE_SPEECH_GEN_FIRST_BANK;
    } else if(bankId >= GTA_PEDS_IDE_SPEECH_GANG_FIRST_BANK && bankId <= GTA_PEDS_IDE_SPEECH_GANG_LAST_BANK) {
        format(archive, archiveSize, "SPC_NA");
        archiveBankId = bankId - GTA_PEDS_IDE_SPEECH_GANG_FIRST_BANK;
    } else if(bankId >= GTA_PEDS_IDE_SPEECH_PLAYER_FIRST_BANK && bankId <= GTA_PEDS_IDE_SPEECH_PLAYER_LAST_BANK) {
        format(archive, archiveSize, "SPC_PA");
        archiveBankId = bankId - GTA_PEDS_IDE_SPEECH_PLAYER_FIRST_BANK;
    } else {
        return false;
    }

    archiveSampleId = sampleId;
    return true;
}

stock bool:TestPedsIdeSpeech(modelId) {
    if(!IsPedIdeLoaded()) {
        print("[omp-gta-peds-ide] ERROR peds.ide is not loaded.");
        return false;
    }

    new modelName[GTA_PEDS_IDE_NAME_LENGTH];

    if(!GetPedsIdeNameByModel(modelId, modelName, sizeof(modelName))) {
        printf("[omp-gta-peds-ide] TEST FAILED: model %d does not exist.", modelId);
        return false;
    }

    new E_GTA_PEDS_IDE_SPEECH_TYPE:type;
    new voiceMin;
    new voiceMax;

    if(!GetPedsIdeSpeechVoicesByModel(modelId, type, voiceMin, voiceMax)) {
        printf("[omp-gta-peds-ide] TEST FAILED: model %d (%s) has no speech voices.", modelId, modelName);
        return false;
    }

    printf("============================================================");
    printf("PED SPEECH TEST");
    printf("modelId:     %d", modelId);
    printf("modelName:   %s", modelName);
    printf("speechType:  %d", _:type);
    printf("voiceRange:  %d .. %d", voiceMin, voiceMax);
    printf("============================================================");

    new totalSamples = 0;
    new totalPlayableSounds = 0;

    for(new contextId = 0; contextId < GTA_PEDS_IDE_SPEECH_GLOBAL_CONTEXT_COUNT; contextId++) {
        new E_GTA_PEDS_IDE_SPEECH_CONTEXT:globalContext = E_GTA_PEDS_IDE_SPEECH_CONTEXT:contextId;

        new sampleCount = GetPedsIdeSpeechSampleCount(modelId, globalContext);

        if(sampleCount <= 0)
            continue;

        printf("");
        printf("CONTEXT %d: samples=%d", _:globalContext, sampleCount);

        totalSamples += sampleCount;

        for(new index = 0; index < sampleCount; index++) {
            new bankId;
            new sampleId;

            if(!GetPedsIdeSpeechSampleByIndex( modelId, globalContext, index, bankId, sampleId)) {
                printf("  [%d] ERROR: GetPedsIdeSpeechSampleByIndex failed", index);
                continue;
            }

            new archive[16];
            new archiveBankId;
            new archiveSampleId;

            if(!GetPedsIdeSpeechArchiveSample(bankId, sampleId, archive, sizeof(archive), archiveBankId, archiveSampleId)) {
                printf("  [%d] bank=%d sample=%d archive=ERROR", index, bankId, sampleId);
                continue;
            }

            new soundId = GetPedsIdeSpeechPlayerPlaySoundId(bankId, sampleId);

            if(soundId != -1) {
                totalPlayableSounds++;

                printf( "  [%d] bank=%d sample=%d soundId=%d archive=%s/%d/%d file='%s/Bank_%03d/sound_%03d.wav'", index, bankId, sampleId, soundId, archive, archiveBankId, archiveSampleId, archive, archiveBankId + 1, archiveSampleId + 1);
            } else {
                printf("  [%d] bank=%d sample=%d soundId=N/A archive=%s/%d/%d file='%s/Bank_%03d/sound_%03d.wav'", index, bankId, sampleId, archive, archiveBankId, archiveSampleId, archive, archiveBankId + 1, archiveSampleId + 1);
            }
        }
    }

    printf("");
    printf("============================================================");
    printf("TOTAL GTA SPEECH SAMPLES:      %d", totalSamples);
    printf("TOTAL PLAYERPLAYSOUND SAMPLES: %d", totalPlayableSounds);
    printf("============================================================");

    return true;
}
